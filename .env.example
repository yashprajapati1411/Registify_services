# ==============================================================================
# Registify Services - Environment Configuration Example
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Frontend environments (Vite) expose all variables prefixed with VITE_ to the browser.
# NEVER place private secrets, master database credentials, or Supabase 'service_role'
# keys in this file or any frontend repository.
# ==============================================================================

# Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (found in Project Settings > API)
# This key is safe for public client-side use when Row-Level Security (RLS) is enabled.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
